generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RECEPTIONIST
  SUPER_ADMIN
}

enum BookingStatus {
  PENDING
  PAID
  CHECKED_IN
  COMPLETED
  CANCELLED
  FAILED
}

enum DiscountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum PermissionStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?
  username  String   @unique
  password  String
  pin       String?
  role      Role     @default(RECEPTIONIST)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts              Shift[]
  checkIns            Booking[]         @relation("CheckedInBy")
  discountsRequested  DiscountRequest[] @relation("RequestedBy")
  discountsDecided    DiscountRequest[] @relation("DecidedBy")
  assignedTasks       Task[]            @relation("AssignedTo")
  createdTasks        Task[]            @relation("CreatedBy")
  taskComments        TaskComment[]
  permissions         Permission[]      @relation("PermissionUser")
  approvedPermissions Permission[]      @relation("PermissionApprover")
}

model Package {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  sublabel  String?
  price     Int
  origPrice Int?
  unit      String
  custom    Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique
  customerName   String
  email          String
  phone          String
  packageId      String
  package        Package       @relation(fields: [packageId], references: [id])
  dates          String?
  amount         Int
  discountAmount Int           @default(0)
  status         BookingStatus @default(PENDING)
  paystackRef    String?       @unique
  checkedInAt    DateTime?
  checkedInById  String?
  checkedInBy    User?         @relation("CheckedInBy", fields: [checkedInById], references: [id])
  emailSent      Boolean       @default(false)
  bookingType    String        @default("ONLINE")
  paymentMethod  String?
  amountPaid     Int?
  changeGiven    Int?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments Payment[]
}

model Payment {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount      Int
  channel     String?
  paystackRef String   @unique
  status      String   @default("success")
  paidAt      DateTime @default(now())
}

model Shift {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockInAt        DateTime  @default(now())
  clockOutAt       DateTime?
  clockInLocation  String
  clockOutLocation String?
  createdAt        DateTime  @default(now())
}

model DiscountRequest {
  id            String         @id @default(cuid())
  bookingRef    String?
  customerName  String
  amountOff     Int
  reason        String
  status        DiscountStatus @default(PENDING)
  requestedById String
  requestedBy   User           @relation("RequestedBy", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?          @relation("DecidedBy", fields: [decidedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Task {
  id           String     @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus @default(PENDING)
  dueDate      DateTime?
  dueForDate   DateTime?
  assignedToId String
  assignedTo   User       @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User       @relation("CreatedBy", fields: [createdById], references: [id])
  repeatType   String     @default("NONE")
  repeatDays   Int?
  repeatDates  String?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  comments TaskComment[]
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Permission {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation("PermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  dateFrom         DateTime
  dateTill         DateTime
  durationDays     Int
  reason           String
  details          String
  status           PermissionStatus @default(PENDING)
  approvedById     String?
  approvedBy       User?            @relation("PermissionApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  cancelledAt      DateTime?
  seenBySuperAdmin Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model PinAttempt {
  id          String    @id @default(cuid())
  username    String    @unique
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}
